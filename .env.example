# Puerto del servidor (en Render o hosting cloud se asigna automaticamente)
PORT=3000

# Entorno: 'development' o 'production'
NODE_ENV=development

# Opcion 1: Base de datos local (MongoDB Community Server)
MONGO_URI=mongodb://127.0.0.1:27017/sumar_impacto

# Opcion 2: Base de datos en la nube (MongoDB Atlas)
# MONGO_URI=mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/sumar_impacto?retryWrites=true&w=majority

# Clave secreta para firma de tokens JWT (Clases 13 y 14)
JWT_SECRET=super_secreto_sumar_impacto_ifts29_jwt_2026
