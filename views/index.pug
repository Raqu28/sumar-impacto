extends layout

block content
  if donacionExitosa
    .alerta.alerta-exito
      strong ¡Aporte recibido con éxito! 
      span Tu donación fue procesada e impactada en la base de datos MongoDB Atlas.

  .caja
    h2 Descripción del Proyecto
    p= descripcion

  .caja
    h3 Integrantes del Grupo - #{equipo}
    ul
      each integrante in integrantes
        li= integrante

  .caja
    .tabla-header
      h3 Proyectos Comunitarios Vigentes (Persistidos en MongoDB Atlas)
      a.btn-accion(href="/donaciones/nueva") + Registrar Donación
    table
      thead
        tr
          th Nombre
          th Organización
          th Categoría
          th Meta ($)
          th Recaudado ($)
          th Progreso (%)
      tbody
        each proyecto in proyectos
          tr(id="proyecto-" + proyecto._id)
            td
              strong= proyecto.nombre
            td= proyecto.organizacion
            td
              span.categoria-badge= proyecto.categoria
            td= `$${proyecto.montoMeta}`
            td.col-recaudado= `$${proyecto.recaudado}`
            td.col-progreso
              span.progreso-badge= `${Math.min(100, Math.round((proyecto.recaudado / proyecto.montoMeta) * 100))}%`
