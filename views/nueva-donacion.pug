extends layout

block content
  h2 Formulario de Registro de Donacion

  form(method="POST", action="/donaciones/nueva")
    label(for="personaId") Donante:
    select(name="personaId", id="personaId", required)
      option(value="") Seleccione un donante...
      each donante in donantes
        option(value=donante.id)= `${donante.nombre} (${donante.email})`

    label(for="proyectoId") Proyecto destino:
    select(name="proyectoId", id="proyectoId", required)
      option(value="") Seleccione un proyecto...
      each proyecto in proyectos
        option(value=proyecto.id)= `${proyecto.nombre} - ${proyecto.organizacion}`

    label(for="monto") Monto a donar ($):
    input(type="number", name="monto", id="monto", min="1", step="any", placeholder="Ej: 5000", required)

    button(type="submit") Confirmar Donacion
